# Copy to backend.hcl (gitignored) and fill in the bucket from bootstrap/
# (the bucket prefix predates the rename to Minus20; see bootstrap/main.tf):
#   terraform -chdir=bootstrap output -raw backend_hcl > backend.hcl
bucket       = "sentinelops-tfstate-xxxxxx"
key          = "eks/terraform.tfstate"
region       = "eu-central-1"
use_lockfile = true
profile      = "minus20"
